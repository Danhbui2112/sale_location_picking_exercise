<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_order_form_add_source_warehouse" model="ir.ui.view">
        <field name="name">sale.order.form.add.source.warehouse</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="after">
                <field name="source_warehouse_id"
                       optional="show"
                       options="{'no_create': True, 'no_open': True}"
                       domain="[('company_id', '=', parent.company_id)]"
                       readonly="parent.state not in ('draft', 'sent')"/>
                <field name="delivery_location_id"
                       optional="hide"
                       readonly="parent.state not in ('draft', 'sent')"
                       domain="[('usage', 'in', ['internal', 'customer'])]"/>
            </xpath>
        </field>
    </record>
</odoo>
